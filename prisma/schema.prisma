generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum RecurringIntervalUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  recurringRules       RecurringRule[]
  recurringFrequencies RecurringFrequency[]
  transfers            Transfer[]

  @@map("users")
}

model Currency {
  id         String    @id @default(cuid())
  code       String    @unique @db.VarChar(3)
  name       String
  minorUnits Int       @default(2) @map("minor_units")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")

  accounts       Account[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  transactions   Transaction[]
  transfers      Transfer[]

  @@map("currencies")
}

model Account {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  currencyId String    @map("currency_id")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency       Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  transfersFrom  Transfer[]      @relation("TransferFromAccount")
  transfersTo    Transfer[]      @relation("TransferToAccount")

  @@index([userId, isDeleted])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  parentId  String?      @map("parent_id")
  name      String
  kind      CategoryKind
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  isDeleted Boolean      @default(false) @map("is_deleted")

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@index([userId, isDeleted])
  @@map("categories")
}

model Transaction {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  accountId  String               @map("account_id")
  currencyId String               @map("currency_id")
  categoryId String?              @map("category_id")
  amount     Decimal              @db.Decimal(19, 4)
  direction  TransactionDirection
  occurredAt DateTime             @map("occurred_at")
  note       String?
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  deletedAt  DateTime?            @map("deleted_at")
  isDeleted  Boolean              @default(false) @map("is_deleted")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currency    Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([userId, isDeleted, occurredAt])
  @@index([accountId])
  @@index([currencyId])
  @@map("transactions")
}

model Transfer {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  fromAccountId String    @map("from_account_id")
  toAccountId   String    @map("to_account_id")
  currencyId    String    @map("currency_id")
  amount        Decimal   @db.Decimal(19, 4)
  occurredAt    DateTime  @map("occurred_at")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")

  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromAccount Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([userId, isDeleted, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

model Budget {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  currencyId  String    @map("currency_id")
  categoryId  String?   @map("category_id")
  name        String
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  limitAmount Decimal   @map("limit_amount") @db.Decimal(19, 4)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency Currency  @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, isDeleted])
  @@map("budgets")
}

model RecurringRule {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  accountId      String               @map("account_id")
  currencyId     String               @map("currency_id")
  categoryId     String?              @map("category_id")
  frequencyId    String               @map("frequency_id")
  name           String
  amount         Decimal              @db.Decimal(19, 4)
  direction      TransactionDirection
  nextRunAt      DateTime             @map("next_run_at")
  endsAt         DateTime?            @map("ends_at")
  maxOccurrences Int?                 @map("max_occurrences")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  isDeleted      Boolean              @default(false) @map("is_deleted")

  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currency  Currency           @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  category  Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  frequency RecurringFrequency @relation(fields: [frequencyId], references: [id], onDelete: Restrict)

  @@index([userId, isDeleted])
  @@index([currencyId])
  @@index([frequencyId])
  @@map("recurring_rules")
}

model RecurringFrequency {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  name      String
  every     Int                   @default(1)
  unit      RecurringIntervalUnit
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  deletedAt DateTime?             @map("deleted_at")
  isDeleted Boolean               @default(false) @map("is_deleted")

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  recurringRules RecurringRule[]

  @@unique([userId, name, isDeleted])
  @@index([userId, isDeleted])
  @@map("recurring_frequencies")
}

model Attachment {
  id            String    @id @default(cuid())
  transactionId String    @map("transaction_id")
  storageKey    String?   @map("storage_key")
  mimeType      String?   @map("mime_type")
  originalName  String?   @map("original_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@map("attachments")
}
