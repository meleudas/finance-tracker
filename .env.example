# --- App ---
NODE_ENV=development
PORT=3000
APP_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Database (host dev: localhost; docker app service uses postgres hostname) ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_tracker?schema=public

# --- Auth (min 32 characters) ---
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!!
# Dev only: default user id when JWT middleware is not mounted (or send X-User-Id header)
# DEV_USER_ID=

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO / S3 (attachments) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=finance-tracker
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Presigned URL TTL (seconds). Default for download/upload links when query omits expiresInSeconds.
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# Attachment limits
ATTACHMENT_MAX_SIZE_BYTES=5242880
# Max expiresInSeconds clients may request on GET attachment / download-url (?expiresInSeconds=)
ATTACHMENT_PRESIGNED_URL_MAX_EXPIRY_SECONDS=3600

# Read cache TTL (seconds)
TRANSACTION_LIST_CACHE_TTL_SECONDS=300
TRANSACTION_ITEM_CACHE_TTL_SECONDS=300
TRANSFER_LIST_CACHE_TTL_SECONDS=300
TRANSFER_ITEM_CACHE_TTL_SECONDS=300
ATTACHMENT_LIST_CACHE_TTL_SECONDS=300
ATTACHMENT_DOWNLOAD_URL_CACHE_TTL_SECONDS=240
